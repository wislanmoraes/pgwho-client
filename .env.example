# ── Obrigatórias ─────────────────────────────────────────────────────────────
DB_PASSWORD=troque_esta_senha_forte
SECRET_KEY=gere_com__openssl_rand_hex_32

# ── Opcionais ─────────────────────────────────────────────────────────────────
DB_USER=pgwho
DB_NAME=pgwho
FRONTEND_PORT=80
IMAGE_TAG=latest

# ── Recursos (opcional) ──────────────────────────────────────────────────────
# Sem estas variáveis vale o perfil mínimo. Para instalações grandes (mais de 15
# instâncias ou mais de 100 GB no banco interno), descomente o perfil abaixo. Mudar
# DB_SHARED_BUFFERS, DB_CPUS ou DB_MEMORY reinicia o banco. Requisitos e o perfil
# médio: docs/requisitos.md
# DB_CPUS=8.0
# DB_MEMORY=32g
# BACKEND_CPUS=2.0
# BACKEND_MEMORY=4g
# DB_SHM_SIZE=1g
# DB_SHARED_BUFFERS=8GB
# DB_EFFECTIVE_CACHE_SIZE=24GB
# DB_WORK_MEM=64MB
# DB_MAINTENANCE_WORK_MEM=2GB
# DB_AUTOVACUUM_WORK_MEM=1GB
# DB_MAX_WAL_SIZE=10GB
# DB_MIN_WAL_SIZE=2GB
# DB_TEMP_FILE_LIMIT=50GB

# ── Integrações de IA (opcional) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Collector (intervalos em segundos) ───────────────────────────────────────
COLLECTOR_INTERVAL_SECONDS=60
ACTIVITY_SAMPLE_INTERVAL_SECONDS=5
ALERT_EVALUATION_INTERVAL_SECONDS=60

# ── System Health (opcional) ─────────────────────────────────────────────────
# Mostra o log do sistema operacional do servidor (/var/log/syslog ou
# /var/log/messages) na tela System Health, só para administradores. Traz
# mensagens de todos os serviços da máquina, por isso vem desligado.
# PGWHO_HOST_LOGS=true

# ── Atualização (update.sh) ───────────────────────────────────────────────────
# As imagens são públicas (#239): sem token.
GHCR_USER=wislanmoraes
